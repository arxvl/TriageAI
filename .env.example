# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DB_PASSWORD=change-me
DB_APP_PASSWORD=change-me-app
DATABASE_URL=postgresql+psycopg://triageai_app:change-me-app@db:5432/triageai
MIGRATION_DATABASE_URL=postgresql+psycopg://triageai:change-me@db:5432/triageai
TEST_DATABASE_URL=postgresql+psycopg://triageai_app:change-me-app@db:5432/triageai_test

# --- Auth / sessions ---
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
SESSION_IDLE_MINUTES=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_TZ_DISPLAY=Asia/Manila

# --- App ---
APP_ENV=dev
TZ_DISPLAY=Asia/Manila

# --- AI pipeline stage selection ---


# rules (manual, M1) | mock
PIPELINE_DEIDENTIFIER=mock
# keywords (manual, M1) | mock
PIPELINE_REDFLAGS=mock
# hosted | ollama (manual, M2) | mock
LLM_PROVIDER=mock
# llm (manual, M3) | mock
PIPELINE_EXTRACTOR=mock

KNOWLEDGE_BASE_DIR=/knowledge_base

KB_INDEXER=pgvector
# pgvector (manual, M6) | mock
PIPELINE_RETRIEVER=mock
# llm (manual, M6) | mock
PIPELINE_GENERATOR=mock
# llm (manual, M6b) | mock
PIPELINE_ACTIONS=mock


MOCK_LLM_BEHAVIOR=ok
MOCK_SLOW_DELAY_S=12


DEMO_FORCE_FAILURE_CASE_TEXT=

# --- Background job worker (ADR-08) ---
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_S=0.5
JOB_STALE_AFTER_MINUTES=2

# --- LLM provider (M2) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=
LLM_SEED=
LLM_JSON_MODE=json_schema
LLM_SCHEMA_IN_PROMPT=true
LLM_SCHEMA_SIMPLIFY=true
LLM_REASONING_EFFORT=
LLM_MAX_RPM=0
LLM_HTTP_RETRIES=2
LLM_RATE_LIMIT_WAIT_S=20
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
OLLAMA_JSON_MODE=json_schema
# --- spike candidates (dev scripts only) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RPM=0
GEMINI_REASONING_EFFORT=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_RPM=0
GROQ_JSON_MODE=json_object

EXTRACTION_PROMPT_VERSION=v1.0
GENERATION_PROMPT_VERSION=v1.0

# --- AI pipeline parameters ---

PIPELINE_MODEL_ID=mock
PIPELINE_PROMPT_VERSION=mock-0
PIPELINE_TEMPERATURE=0
PIPELINE_TOP_K=5
PIPELINE_TIMEOUT_S=30
PIPELINE_MAX_RETRIES=1
RETRIEVAL_MIN_SCORE=0.30

ACTIONS_PROMPT_VERSION=v1.0
ACTIONS_MAX_ITEMS=5

# --- Embeddings (M4) ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_WARMUP=true

# --- KB Chunking (M5) ---
KB_CHUNK_TARGET_WORDS=150
KB_CHUNK_OVERLAP_SENTENCES=1

# --- Retrieval (M6) ---
# pgvector HNSW search breadth. Raise (e.g. 100) if a query returns fewer than k
# passages although enough chunks exist.
HNSW_EF_SEARCH=40
