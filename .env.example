# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Password for the PostgreSQL owner role used by the db container.
DB_PASSWORD=change-me
# Password for the restricted application role `triageai_app`, created by
# migration 0002. The app connects as this role; it cannot UPDATE or DELETE
# audit_log, nor UPDATE owner_descriptions (FR-05, FR-43, ADR-12).
DB_APP_PASSWORD=change-me-app
# SQLAlchemy connection string the application uses: the restricted role.
DATABASE_URL=postgresql+psycopg://triageai_app:change-me-app@db:5432/triageai
# SQLAlchemy connection string Alembic uses: the owner role. Migrations create
# and grant; the application never connects with this (ADR-12).
MIGRATION_DATABASE_URL=postgresql+psycopg://triageai:change-me@db:5432/triageai
# Connection string for the separate test database (triageai_test). Tests run
# as the restricted role so they prove the protections really hold.
TEST_DATABASE_URL=postgresql+psycopg://triageai_app:change-me-app@db:5432/triageai_test

# --- Auth / sessions ---
# Signing key for session JWTs. Generate a long random value per environment.
SECRET_KEY=change-me
# Minutes of inactivity before a session expires.
SESSION_IDLE_MINUTES=30

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# Base URL the React app uses to call the API (read by Vite as import.meta.env.VITE_API_BASE_URL).
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Timezone the React app renders stored UTC timestamps in. Keep this in step
# with TZ_DISPLAY below; the browser cannot read the backend's copy.
VITE_TZ_DISPLAY=Asia/Manila

# --- App ---
# dev | test | prod. Controls logging verbosity and debug behavior.
APP_ENV=dev
# Timezone the frontend displays timestamps in. Timestamps are stored in UTC.
TZ_DISPLAY=Asia/Manila

# --- AI pipeline stage selection (CLAUDE.md §8.3) ---
# All stages default to their mock implementation. Non-mock values are wired
# up manually per the Mx guides; do not change these outside a manual phase.

# rules (manual, M1) | mock
PIPELINE_DEIDENTIFIER=mock
# keywords (manual, M1) | mock
PIPELINE_REDFLAGS=mock
# hosted | ollama (manual, M2) | mock
LLM_PROVIDER=mock
# llm (manual, M3) | mock
PIPELINE_EXTRACTOR=mock
# sentence_transformer (manual, M4). Unset/blank unless a real embedding
# stage is enabled — mock stages need no embedding provider.
EMBEDDING_PROVIDER=
# pgvector (manual, M5) | mock
KB_INDEXER=mock
# pgvector (manual, M6) | mock
PIPELINE_RETRIEVER=mock
# llm (manual, M6) | mock
PIPELINE_GENERATOR=mock

# Which failure the mock stages simulate, so every path in the orchestrator can
# be demonstrated without a network call (P05 §5.2, ADR-17):
#   ok           normal behavior
#   invalid_json every attempt returns unusable output -> manual triage
#   timeout      the stage times out -> manual triage
#   flaky        the first attempt fails, the retry succeeds
#   slow         answers late (about 0.25 s per model stage) but within the
#                timeout
# This applies to the extraction and generation stages only: the pre-screen and
# retrieval keep answering, so a red-flag alert still reaches the queue (NFR-05).
# The DEMO_4 scenario in tests/fixtures/demo_cases.yaml forces its own failure
# whatever this is set to, so the manual-triage path can be shown without
# changing this value.
MOCK_LLM_BEHAVIOR=ok

# --- AI pipeline parameters (CLAUDE.md §8.3) ---
# Read once into PipelineConfig and handed to every stage. Changing one changes
# what is stored as a run's provenance (FR-26, NFR-23, ADR-14).

# Model identifier recorded with each AI output. "mock" while stages are mocked;
# the real stages report their own value.
PIPELINE_MODEL_ID=mock
# Prompt template version recorded with each AI output, e.g. extraction/v1.0.
# "mock-0" while stages are mocked.
PIPELINE_PROMPT_VERSION=mock-0
# Sampling temperature. Keep at 0: the same description must give the same
# recommendation, or the evaluation numbers measure nothing.
PIPELINE_TEMPERATURE=0
# How many knowledge base passages retrieval returns per case.
PIPELINE_TOP_K=5
# Seconds a single model call may take before it counts as a timeout.
PIPELINE_TIMEOUT_S=30
# Retries after unusable model output. Only a schema violation is retried; a
# timeout is not.
PIPELINE_MAX_RETRIES=1
# Cosine similarity below which the retrieved passages are too weak to support a
# confident recommendation. The safety validator caps confidence rather than
# discarding them (FR-22, FR-23).
RETRIEVAL_MIN_SCORE=0.30
