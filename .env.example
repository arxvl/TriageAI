# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Password for the PostgreSQL owner role used by the db container.
DB_PASSWORD=change-me
# Password for the restricted application role `triageai_app`, created by
# migration 0002. The app connects as this role; it cannot UPDATE or DELETE
# audit_log, nor UPDATE owner_descriptions (FR-05, FR-43, ADR-12).
DB_APP_PASSWORD=change-me-app
# SQLAlchemy connection string the application uses: the restricted role.
DATABASE_URL=postgresql+psycopg://triageai_app:change-me-app@db:5432/triageai
# SQLAlchemy connection string Alembic uses: the owner role. Migrations create
# and grant; the application never connects with this (ADR-12).
MIGRATION_DATABASE_URL=postgresql+psycopg://triageai:change-me@db:5432/triageai
# Connection string for the separate test database (triageai_test). Tests run
# as the restricted role so they prove the protections really hold.
TEST_DATABASE_URL=postgresql+psycopg://triageai_app:change-me-app@db:5432/triageai_test

# --- Auth / sessions ---
# Signing key for session JWTs. Generate a long random value per environment.
SECRET_KEY=change-me
# Minutes of inactivity before a session expires.
SESSION_IDLE_MINUTES=30

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# Base URL the React app uses to call the API (read by Vite as import.meta.env.VITE_API_BASE_URL).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- App ---
# dev | test | prod. Controls logging verbosity and debug behavior.
APP_ENV=dev
# Timezone the frontend displays timestamps in. Timestamps are stored in UTC.
TZ_DISPLAY=Asia/Manila

# --- AI pipeline stage selection (CLAUDE.md §8.3) ---
# All stages default to their mock implementation. Non-mock values are wired
# up manually per the Mx guides; do not change these outside a manual phase.

# rules (manual, M1) | mock
PIPELINE_DEIDENTIFIER=mock
# keywords (manual, M1) | mock
PIPELINE_REDFLAGS=mock
# hosted | ollama (manual, M2) | mock
LLM_PROVIDER=mock
# llm (manual, M3) | mock
PIPELINE_EXTRACTOR=mock
# sentence_transformer (manual, M4). Unset/blank unless a real embedding
# stage is enabled — mock stages need no embedding provider.
EMBEDDING_PROVIDER=
# pgvector (manual, M5) | mock
KB_INDEXER=mock
# pgvector (manual, M6) | mock
PIPELINE_RETRIEVER=mock
# llm (manual, M6) | mock
PIPELINE_GENERATOR=mock

# Behavior of the mock LLM provider: ok | timeout | invalid_output | unavailable
MOCK_LLM_BEHAVIOR=ok
